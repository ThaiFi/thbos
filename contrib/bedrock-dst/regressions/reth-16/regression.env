# tempoxyz/bedrock#16 (found by this harness): after a SIGKILL, the startup
# "partial state trie" unwind can leave an orphan storage-trie branch (its
# parent's tree_mask bit clear). Proof v2 adopts it, so the sparse-trie task
# seals a block with a wrong stateRoot; the reference node rejects it.
# Candidate fix: paradigmxyz/reth#27832 (delete orphaned branches on
# recovery). buggy = every other known fix; fixed = the same plus #27832.
# Hits about 1% of default-flag trie seeds, so run hundreds of seeds per side.
RETH_FIX_PR=27832
RETH_FIX_HEAD=6ee446ac58f89305894acea36171d4154c91c74b
BASE_RETH_PRS="27615:30904dc4158defd496565da8f28671af81096091 27817:733a14c10acd40ebdf16a8a60255051722e55c93"
BASE_TEMPO_PRS="8189:75d7773eb77a8866301936c7ac0de6c61a70ff7b 8197:4df0c17ddcf3fd7b40ce89b7c4f385c9c597ad84"
BASE_RETH_PATCHES="worker-map-self-join.patch"
STRIP_DEBUG=1
VARIANT=default
CAMPAIGN_ARGS="--workload-arg load=trie --workload-arg reference=true"
# The compare-updates storage-trie diff is #16's first and most specific
# signal (E7/reference-state-root-mismatch follows with --reference).
EXPECT=E1/trie-diff
