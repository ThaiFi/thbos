# Not a regression: the node with every known bug fixed, built as
# bedrock/tempo-localnet:known-fixes for campaigns hunting new bugs. Any
# failure on it is a novel-bug candidate (or a missing entry here).
# Built from Tempo main (not the old pin) so hunts run on current code, with
# reth 6824346: Tempo's pin 17279c2 plus three commits, reth#27805 (the
# WorkerMap self-join fix) and two CI-only changes. Fixes now upstream and
# so dropped: tempo#8189 (#13), tempo#8197 (#15), reth#27832 (#16), the
# WorkerMap patch (reth#27805). Still applied:
# - reth#27615 (open): historical overlays miss transient trie nodes.
# - reth#27817 (open): eth_getProof via V2 proofs (tempoxyz/bedrock#14).
TEMPO_REV=4a34b6c31ef6f4b0aa941a7e9d2d42bfd81641af
RETH_REV=682434663aff83881f7ed1b9fc8c813b8ba9b51a
BASE_RETH_PRS="27615:30904dc4158defd496565da8f28671af81096091 27817:733a14c10acd40ebdf16a8a60255051722e55c93"
BASE_TEMPO_PRS=""
# reth#27615 predates reth's SortedTrieData refactor (its fields were
# flattened); this one-line port lets it compile at RETH_REV.
BASE_RETH_PATCHES="reth-27615-port.patch"
# Debuginfo stripped: the guest holds the image in RAM.
STRIP_DEBUG=1
VARIANT=default
CAMPAIGN_ARGS="--workload-arg load=trie"
