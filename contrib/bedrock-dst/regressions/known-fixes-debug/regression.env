# known-fixes with debug assertions: the node with every known bug
# fixed, built with `-C debug-assertions=on` so reth's and Tempo's internal
# debug_assert! invariants (trie, sparse trie, persistence, engine tree) run.
# A violation panics; E1/panic reports it. Slower than release; for hunts.
# Same revisions and fixes as known-fixes (Tempo main).
TEMPO_REV=4a34b6c31ef6f4b0aa941a7e9d2d42bfd81641af
RETH_REV=682434663aff83881f7ed1b9fc8c813b8ba9b51a
BASE_RETH_PRS="27615:30904dc4158defd496565da8f28671af81096091 27817:733a14c10acd40ebdf16a8a60255051722e55c93"
BASE_TEMPO_PRS=""
# reth#27615 predates reth's SortedTrieData refactor (its fields were
# flattened); this one-line port lets it compile at RETH_REV.
BASE_RETH_PATCHES="reth-27615-port.patch"
DEBUG_ASSERTIONS=1
# Debuginfo stripped: the guest holds the image in RAM.
STRIP_DEBUG=1
VARIANT=default
CAMPAIGN_ARGS="--workload-arg load=trie"
