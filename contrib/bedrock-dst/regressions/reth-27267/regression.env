# paradigmxyz/reth#27267 "fix(trie): decode inline witness children".
# Before the fix, eth_getMultiProof (proof v2) emitted a leaf inlined in its
# parent (encoding < 32 bytes) as a standalone proof node too, so the proof
# fails verification. Needs two written slots sharing 7+ keccak nibbles; values
# below 0x80 keep their leaves inline: the generated load covers both.
RETH_REVERT=46c1e16ec219ab608b5a0ed6a89f0449423585a9
# reth#27615 (unmerged) produces the same E5/E6 multiproof-* and untargeted-*
# signatures on the pinned node; apply it to both images.
BASE_RETH_PRS="27615:30904dc4158defd496565da8f28671af81096091"
VARIANT=default
CAMPAIGN_ARGS="--workload-arg load=trie"
EXPECT=E6/multiproof-storage-proof-invalid
