# known-fixes on the DST build profile: Tempo tempo#8198 + reth reth#27819
# ('dst' profile = opt-level 3, thin LTO, debug assertions + overflow checks;
# 'dst' feature gates only the expensive sparse-trie/MDBX/storage-layout
# checks). ~13.6 us/transfer vs 203 unoptimized debug (tempo#8198), so
# debug-assertion hunts run near release speed. Both PRs are based on newer
# upstream than our pins, so this entry builds from their heads; reth is the
# rev tempo#8198 pins. Known fixes as in known-fixes.
TEMPO_REV=f5e480e1c7645ff68e7770fbcd315faa5dcbb40c
RETH_REV=f7ca4f1f23e4e3af04089c9d87a061ce4a72510a
RUST_PROFILE=dst
RUST_FEATURES="asm-keccak,jemalloc,otlp,dst"
BASE_RETH_PRS="27615:30904dc4158defd496565da8f28671af81096091 27817:733a14c10acd40ebdf16a8a60255051722e55c93"
BASE_TEMPO_PRS="8189:75d7773eb77a8866301936c7ac0de6c61a70ff7b 8197:4df0c17ddcf3fd7b40ce89b7c4f385c9c597ad84"
BASE_RETH_PATCHES="worker-map-self-join.patch"
# Debuginfo stripped: the guest holds the image in RAM.
STRIP_DEBUG=1
VARIANT=default
CAMPAIGN_ARGS="--workload-arg load=trie"
