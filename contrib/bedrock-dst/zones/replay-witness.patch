+
+/// Offline SPF replay of a saved witness. Reads no RPC and submits nothing;
+/// it only re-executes the batch the witness describes, so a witness that
+/// describes an invalid state transition is rejected by the SPF here exactly
+/// as the enclave would reject it. Prints `REPLAY <nextBlockHash>` or
+/// `REPLAY-ERR <message>` and never fails the process on an SPF rejection.
+async fn replay_witness(args: ReplayWitnessArgs) -> Result<()> {
+    let bytes = std::fs::read(&args.input)
+        .wrap_err_with(|| format!("read witness {}", args.input.display()))?;
+    let witness: BatchWitness =
+        serde_json::from_slice(&bytes).context("decode batch witness JSON")?;
+    let chain = load_chain(&args.chain).await?;
+    let spf_config = SpfConfig::new(chain);
+    match prove_zone_batch(&spf_config, witness) {
+        Ok(output) => println!("REPLAY {}", output.block_transition.nextBlockHash),
+        Err(error) => println!("REPLAY-ERR {error:#}"),
     }
+    Ok(())
 }
 
